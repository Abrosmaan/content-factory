---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? 'Content Factory blog'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <style>
      :root { color-scheme: dark; }
      body {
        background: #0e1014; color: #e8e8e8;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI";
        margin: 0; line-height: 1.55;
      }
      main { max-width: 720px; margin: 0 auto; padding: 32px 20px 80px; }
      a { color: #e4a845; }
      a:hover { color: #fff; }
      h1, h2, h3 { line-height: 1.2; }
      .product {
        border: 1px solid #2a2e36; background: #15171c;
        padding: 14px 16px; border-radius: 12px; margin: 12px 0;
      }
      .product strong { display: block; margin-bottom: 4px; }
      .product .ftc { font-size: 12px; color: #a0a0a0; margin-top: 8px; }
      .meta { color: #969aa1; font-size: 14px; margin-bottom: 16px; }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
