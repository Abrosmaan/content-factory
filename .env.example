# ============================================================
# CONTENT FACTORY — ENV TEMPLATE
# Заполняй сверху вниз по мере регистрации сервисов.
# Реальные значения хранятся ТОЛЬКО в .env (gitignored).
# ============================================================

# ------------------------------------------------------------
# ЭПИК 1 — нужно до запуска агента
# ------------------------------------------------------------

# Hetzner VPS
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY_PATH=

# Supabase (supabase.com → Settings → Database/API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Cloudflare R2 (cloudflare.com → R2 → Manage API tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_FOOTAGE=
R2_BUCKET_RENDERS=

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Telegram (@BotFather → /newbot // @userinfobot → твой ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ------------------------------------------------------------
# ЭПИК 2
# ------------------------------------------------------------

# ElevenLabs (elevenlabs.io → Profile → API Key)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# fal.ai (fal.ai → Dashboard → API Keys)
FAL_API_KEY=

# Creatomate (creatomate.com → Settings → API)
CREATOMATE_API_KEY=
# Pre-built short template ID (creatomate UI → Templates)
CREATOMATE_TEMPLATE_SHORT=

# ------------------------------------------------------------
# ЭПИК 3
# ------------------------------------------------------------

# YouTube (console.cloud.google.com → OAuth 2.0 → YouTube Data API v3)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=   # получить через `python -m src.cli.yt_auth`

# ------------------------------------------------------------
# ЭПИК 4
# ------------------------------------------------------------
#
# AL-002 (2026-06-15): Reddit перешёл на RSS-парсинг без auth.
# Список сабреддитов редактируется в src/core/trend_sources.py.

# ------------------------------------------------------------
# ЭПИК 5
# ------------------------------------------------------------

# Healthchecks.io (healthchecks.io → New Check → ping URL)
HEALTHCHECKS_PING_URL=

# ------------------------------------------------------------
# ЭПИК 6
# ------------------------------------------------------------

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
BLOG_DOMAIN=

# Pinterest (developers.pinterest.com → App → Access token)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID_GAMING=
PINTEREST_BOARD_ID_SETUP=

# Threads / Meta (developers.facebook.com → Threads API → long-lived token)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
